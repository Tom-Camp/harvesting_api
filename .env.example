# PostgreSQL
POSTGRES_USER=harvest
POSTGRES_PASSWORD=harvest
POSTGRES_DB=harvest_food
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Anthropic — https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# GitHub — fine-grained token with Issues: Read & Write on the target repo
GITHUB_TOKEN=your-github-token
GITHUB_REPO=owner/repo

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@harvesting.food

# App
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
JSON_LOGS=false
